#MAIN CODE

import numpy as np

np.random.seed(42)

X = np.array([
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1]
], dtype=float)

y = np.array([
    [0],
    [1],
    [1],
    [0]
], dtype=float)

def sigmoid(x):
    return 1 / (1 + np.exp(-np.clip(x, -500, 500)))

def sigmoid_derivative(x):
    return x * (1 - x)

input_neurons = 2
hidden_neurons = 4
output_neurons = 1
learning_rate = 0.5
epochs = 10000

weights_input_hidden = np.random.uniform(
    -1, 1, (input_neurons, hidden_neurons)
)
weights_hidden_output = np.random.uniform(
    -1, 1, (hidden_neurons, output_neurons)
)

bias_hidden = np.zeros((1, hidden_neurons))
bias_output = np.zeros((1, output_neurons))

for epoch in range(epochs):
    hidden_input = np.dot(X, weights_input_hidden) + bias_hidden
    hidden_output = sigmoid(hidden_input)

    final_input = np.dot(hidden_output, weights_hidden_output) + bias_output
    predicted_output = sigmoid(final_input)

    error = y - predicted_output

    output_delta = error * sigmoid_derivative(predicted_output)
    hidden_error = np.dot(output_delta, weights_hidden_output.T)
    hidden_delta = hidden_error * sigmoid_derivative(hidden_output)

    weights_hidden_output += np.dot(
        hidden_output.T, output_delta
    ) * learning_rate

    bias_output += np.sum(
        output_delta, axis=0, keepdims=True
    ) * learning_rate

    weights_input_hidden += np.dot(
        X.T, hidden_delta
    ) * learning_rate

    bias_hidden += np.sum(
        hidden_delta, axis=0, keepdims=True
    ) * learning_rate

    if (epoch + 1) % 2000 == 0:
        loss = np.mean((y - predicted_output) ** 2)
        print("Epoch:", epoch + 1, "Loss:", round(loss, 6))

hidden_output = sigmoid(
    np.dot(X, weights_input_hidden) + bias_hidden
)
predicted_output = sigmoid(
    np.dot(hidden_output, weights_hidden_output) + bias_output
)

print("\nTesting Results")
print("Input\t\tActual\tPredicted")

for i in range(len(X)):
    prediction = 1 if predicted_output[i][0] >= 0.5 else 0
    print(X[i], "\t", int(y[i][0]), "\t", prediction)

print("\nFinal Output Probabilities:")
print(np.round(predicted_output, 4))



